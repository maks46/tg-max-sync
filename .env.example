# Telegram Bot settings
TELEGRAM_BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff-1234567890
TELEGRAM_GROUP_ID=-1001234567890

# Green API settings for MAX messenger
# Get these from your Green API console: https://console.green-api.com
GREEN_API_URL=https://api.green-api.com
GREEN_API_MEDIA_URL=https://media.green-api.com
GREEN_API_INSTANCE=3100000000
GREEN_API_TOKEN=your_api_token_instance_here

# MAX target group chat ID (numeric, negative for groups)
# e.g. -10000000000000
MAX_GROUP_ID=-10000000000000

# Sync settings
SYNC_INTERVAL=2         # seconds between poll cycles

# ── xray / VPN settings (optional) ───────────────────────────────────────────
#
# Option A — subscription URL (recommended, works like happ on Android):
#   Set XRAY_SUBSCRIPTION_URL to your provider's subscription link.
#   On container start the script downloads the list, picks server #XRAY_SERVER_INDEX
#   and writes xray/config.json automatically.
#
XRAY_SUBSCRIPTION_URL=https://your-provider.example.com/sub/token
XRAY_SERVER_INDEX=0        # 0-based index in the subscription list
XRAY_SOCKS_PORT=10808      # local SOCKS5 port xray will listen on
# User-Agent sent when fetching the subscription.
# Some providers check UA to decide which servers to return.
# Common values: clash-meta/1.18.0  ClashforAndroid/2.5.12  v2rayNG/1.8.0
XRAY_USER_AGENT=clash-meta/1.18.0
#
# Option B — manual config:
#   Copy xray/config.json.example → xray/config.json and fill in server details.
#   Leave XRAY_SUBSCRIPTION_URL empty.
#
# After enabling xray, point Telegram traffic through it:
TELEGRAM_PROXY=socks5h://127.0.0.1:10808
#
# To disable entirely (direct connection):
# TELEGRAM_PROXY=
# XRAY_SUBSCRIPTION_URL=

# Log settings
LOG_LEVEL=info          # debug | info | warning | error
LOG_MAX_SIZE=10M        # max size of app.log before rotation (K / M / G)
LOG_MAX_FILES=5         # number of rotated files to keep (app.log.1 … app.log.N)
